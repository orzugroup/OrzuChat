# Copy to .env on the Hetzner VPS. Never commit real secrets.

CHAT_DOMAIN=chat.example.com
ALLOWED_ORIGINS=*

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# wss URL the mobile app uses, e.g. wss://rtc.chat.example.com
LIVEKIT_URL=wss://rtc.chat.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-long-random-secret

CALL_RING_TIMEOUT_SEC=45
